# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/quizarena?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=30m

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=168h

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Rate Limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=20

# Request Timeout
REQUEST_TIMEOUT=30s
